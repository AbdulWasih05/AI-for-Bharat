# Nirman Mitra — Environment Variables
# Copy to .env and fill in your values: cp .env.example .env

# ─────────────────────────────────────────────────────────
# AWS (auto-set by SAM on Lambda — only needed for local dev)
# ─────────────────────────────────────────────────────────
AWS_REGION=ap-south-1

# ─────────────────────────────────────────────────────────
# ENVIRONMENT
# ─────────────────────────────────────────────────────────
ENVIRONMENT=dev
CERTIFICATE_THRESHOLD=3

# ─────────────────────────────────────────────────────────
# WHATSAPP BUSINESS API (from Meta Developer Console)
# ─────────────────────────────────────────────────────────
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=nirman-mitra-verify-token

# ─────────────────────────────────────────────────────────
# BEDROCK (LLM)
# ─────────────────────────────────────────────────────────
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_LIGHT_MODEL_ID=amazon.nova-lite-v1:0

# ─────────────────────────────────────────────────────────
# LLM FALLBACK (optional — insurance for Bedrock throttling)
# ─────────────────────────────────────────────────────────
PRIMARY_LLM_PROVIDER=bedrock
FALLBACK_LLM_PROVIDER=
FALLBACK_API_KEY=

# ─────────────────────────────────────────────────────────
# REKOGNITION
# ─────────────────────────────────────────────────────────
REKOGNITION_COLLECTION_ID=nirman-mitra-workers

# ─────────────────────────────────────────────────────────
# FRONTEND (only for admin-dashboard build)
# ─────────────────────────────────────────────────────────
VITE_API_URL=
